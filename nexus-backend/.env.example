# Ambiente local. No use ENVIRONMENT=production sem configurar os valores de
# produção no provedor de hospedagem.
ENVIRONMENT=development

# Gere um segredo local com:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nunca reutilize este placeholder ou um segredo local em produção.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Connection string PostgreSQL. Substitua todos os valores de exemplo.
PG_DSN=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Origens locais permitidas, separadas por vírgula e sem barra final.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Bloqueio de login por tentativas.
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPTS_WINDOW_MINUTES=15

# SMTP (opcional; preencha se os fluxos de e-mail forem utilizados).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@nexus2.com.br
SMTP_FROM_NAME=NEXUS 2.0

# Blob privado: conecte o store ao projeto Vercel. Para desenvolvimento local,
# use "vercel link" e "vercel env pull"; não versione tokens/OIDC neste arquivo.
